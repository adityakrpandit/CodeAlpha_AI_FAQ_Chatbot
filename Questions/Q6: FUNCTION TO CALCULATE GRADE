/*
Q6: FUNCTION TO CALCULATE GRADE

Aim:
To create a function that accepts a percentage
and returns the corresponding grade.

Grading Criteria:
80 and above = A
60 to below 80 = B
40 to below 60 = C
Below 40 = Fail
*/

-- STEP 1: CREATE FUNCTION

CREATE OR REPLACE FUNCTION GET_GRADE(
    P_PERCENTAGE NUMBER
)
RETURN VARCHAR2
IS
BEGIN
    IF P_PERCENTAGE < 0 OR P_PERCENTAGE > 100 THEN
        RETURN 'Invalid Percentage';
    ELSIF P_PERCENTAGE >= 80 THEN
        RETURN 'A';
    ELSIF P_PERCENTAGE >= 60 THEN
        RETURN 'B';
    ELSIF P_PERCENTAGE >= 40 THEN
        RETURN 'C';
    ELSE
        RETURN 'Fail';
    END IF;
END;
/

-- STEP 2: CHECK COMPILATION

SHOW ERRORS;

-- STEP 3: TEST CASES

SELECT GET_GRADE(85) AS GRADE FROM DUAL;
-- Expected Output: A

SELECT GET_GRADE(70) AS GRADE FROM DUAL;
-- Expected Output: B

SELECT GET_GRADE(45) AS GRADE FROM DUAL;
-- Expected Output: C

SELECT GET_GRADE(30) AS GRADE FROM DUAL;
-- Expected Output: Fail

SELECT GET_GRADE(105) AS GRADE FROM DUAL;
-- Expected Output: Invalid Percentage

-- STEP 4: RESULT
-- The function successfully returns the grade
-- corresponding to the given percentage.

