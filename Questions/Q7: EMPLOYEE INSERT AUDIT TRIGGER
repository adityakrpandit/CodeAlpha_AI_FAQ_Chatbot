/*
Q7: EMPLOYEE INSERT AUDIT TRIGGER

Aim:
To create an EMP_AUDIT table and a trigger that
stores employee details whenever a new employee
record is inserted into EMP.

Existing EMP table columns:
EID, ENAME, DEPTNO, DEPTNAME, GENDER, AGE, BASICSAL
*/

-- STEP 1: CREATE EMP_AUDIT TABLE

CREATE TABLE EMP_AUDIT (
    EID NUMBER(5),
    ENAME VARCHAR2(30),
    DEPTNO NUMBER,
    DEPTNAME VARCHAR2(30),
    GENDER VARCHAR2(10),
    AGE NUMBER,
    BASICSAL NUMBER(10,2),
    INSERT_DATE DATE
);

-- STEP 2: CREATE TRIGGER

CREATE OR REPLACE TRIGGER TRG_EMP_INSERT
AFTER INSERT ON EMP
FOR EACH ROW
BEGIN
    INSERT INTO EMP_AUDIT (
        EID,
        ENAME,
        DEPTNO,
        DEPTNAME,
        GENDER,
        AGE,
        BASICSAL,
        INSERT_DATE
    )
    VALUES (
        :NEW.EID,
        :NEW.ENAME,
        :NEW.DEPTNO,
        :NEW.DEPTNAME,
        :NEW.GENDER,
        :NEW.AGE,
        :NEW.BASICSAL,
        SYSDATE
    );
END;
/

-- STEP 3: CHECK TRIGGER COMPILATION

SHOW ERRORS;

-- STEP 4: INSERT A NEW EMPLOYEE

INSERT INTO EMP
VALUES (104, 'Neha', 40, 'Finance', 'Female', 24, 28000);

COMMIT;

-- STEP 5: CHECK AUDIT TABLE

SELECT * FROM EMP_AUDIT;

-- Expected:
-- EID = 104
-- ENAME = Neha
-- DEPTNO = 40
-- DEPTNAME = Finance
-- GENDER = Female
-- AGE = 24
-- BASICSAL = 28000
-- INSERT_DATE = Current database date and time

-- STEP 6: RESULT
-- Whenever a new employee is inserted into EMP,
-- the trigger automatically stores the employee's
-- details and insertion date in EMP_AUDIT.

