/*
Q12: TRIGGER TO PREVENT EMPLOYEE DELETION

Aim:
To create a trigger that prevents deletion of employees
belonging to a particular department.

Condition:
Employees belonging to Department 10 cannot be deleted.
*/

-- STEP 1: CREATE TRIGGER

CREATE OR REPLACE TRIGGER TRG_PREVENT_DELETE
BEFORE DELETE ON EMP
FOR EACH ROW
BEGIN
    IF :OLD.DEPTNO = 10 THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            'Deletion not allowed for Department 10.'
        );
    END IF;
END;
/

-- STEP 2: CHECK TRIGGER ERRORS

SHOW ERRORS;

-- STEP 3: CHECK EMPLOYEE RECORDS

SELECT EID, ENAME, DEPTNO
FROM EMP;

-- STEP 4: TEST CASE 1
-- Try deleting an employee from Department 10.
-- Use an EID that actually belongs to Department 10.

DELETE FROM EMP
WHERE EID = 101;

-- Expected:
-- ORA-20001: Deletion not allowed for Department 10.
-- The employee record will not be deleted.

-- STEP 5: TEST CASE 2
-- To test an allowed deletion, use a disposable test
-- employee whose DEPTNO is not 10.
-- Example, if EID 105 belongs to Department 50:
--
-- DELETE FROM EMP WHERE EID = 105;
--
-- This deletion is allowed by the trigger.
-- Do not run this test if you want to keep that employee.

-- STEP 6: RESULT
-- The trigger prevents deletion of employees
-- belonging to Department 10.

