/*
Q3: USER-DEFINED EXCEPTION INVALID_AGE

Aim:
To raise a user-defined exception when an employee's
age is outside the permitted range of 18 to 60 years.

Table: EMP
Age Column: AGE
Permitted Age Range: 18 to 60
*/

-- STEP 1: CHECK EMP TABLE

DESC EMP;

-- STEP 2: DISPLAY EMPLOYEE DATA

SELECT EID, ENAME, AGE
FROM EMP;

-- STEP 3: PL/SQL PROGRAM

SET SERVEROUTPUT ON;

DECLARE
    V_AGE EMP.AGE%TYPE;
    INVALID_AGE EXCEPTION;

BEGIN
    V_AGE := &AGE;

    IF V_AGE < 18 OR V_AGE > 60 THEN
        RAISE INVALID_AGE;
    ELSE
        DBMS_OUTPUT.PUT_LINE('Age is valid.');
    END IF;

EXCEPTION
    WHEN INVALID_AGE THEN
        DBMS_OUTPUT.PUT_LINE(
            'Invalid age. Age must be between 18 and 60.'
        );
END;
/

-- STEP 4: TEST CASES
--
-- Test Case 1:
-- Input: 25
-- Output: Age is valid.
--
-- Test Case 2:
-- Input: 15
-- Output: Invalid age. Age must be between 18 and 60.
--
-- Test Case 3:
-- Input: 65
-- Output: Invalid age. Age must be between 18 and 60.

-- STEP 5: RESULT
--
-- The INVALID_AGE user-defined exception was
-- successfully raised and handled when the entered
-- age was outside the permitted range.

