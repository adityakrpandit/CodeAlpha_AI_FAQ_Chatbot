/*
Q13: STORED FUNCTION TO CALCULATE EMPLOYEE BONUS

Aim:
To create a stored function that accepts an employee's
salary and returns the bonus amount.

Formula:
Bonus = Salary * 10%
*/

-- STEP 1: CREATE FUNCTION

CREATE OR REPLACE FUNCTION CALC_BONUS(
    P_SALARY NUMBER
)
RETURN NUMBER
IS
BEGIN
    RETURN P_SALARY * 0.10;
END;
/

-- STEP 2: CHECK COMPILATION

SHOW ERRORS;

-- STEP 3: TEST WITH A SALARY

SELECT CALC_BONUS(30000) AS BONUS
FROM DUAL;

-- Expected Output: 3000

-- STEP 4: ACCEPT SALARY AS INPUT

SELECT CALC_BONUS(&SALARY) AS BONUS
FROM DUAL;

-- Example Input: 25000
-- Expected Output: 2500

-- STEP 5: RESULT
-- The function successfully calculates and returns
-- 10% of the given salary as bonus.

