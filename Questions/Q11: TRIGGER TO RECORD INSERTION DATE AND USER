/*
Q11: TRIGGER TO RECORD INSERTION DATE AND USER

Aim:
To create a trigger that automatically records the
insertion date and database username whenever a new
employee record is inserted.
*/

-- STEP 1: CREATE AUDIT TABLE
-- Run only if EMP_INSERT_AUDIT does not already exist.

CREATE TABLE EMP_INSERT_AUDIT (
    EID NUMBER(5),
    ENAME VARCHAR2(30),
    INSERT_DATE DATE,
    INSERT_USER VARCHAR2(128)
);

-- STEP 2: CREATE TRIGGER

CREATE OR REPLACE TRIGGER TRG_INSERT_INFO
AFTER INSERT ON EMP
FOR EACH ROW
BEGIN
    INSERT INTO EMP_INSERT_AUDIT (
        EID,
        ENAME,
        INSERT_DATE,
        INSERT_USER
    )
    VALUES (
        :NEW.EID,
        :NEW.ENAME,
        SYSDATE,
        USER
    );
END;
/

-- STEP 3: CHECK TRIGGER ERRORS

SHOW ERRORS;

-- STEP 4: INSERT A TEST EMPLOYEE
-- Use an EID that does not already exist in EMP.

INSERT INTO EMP
    (EID, ENAME, DEPTNO, DEPTNAME, GENDER, AGE, BASICSAL)
VALUES
    (105, 'Karan', 50, 'IT', 'Male', 26, 27000);

COMMIT;

-- STEP 5: DISPLAY AUDIT RECORD

SELECT * FROM EMP_INSERT_AUDIT;

-- Expected:
-- EID = 105
-- ENAME = Karan
-- INSERT_DATE = Current database date and time
-- INSERT_USER = Current Oracle username

-- STEP 6: RESULT
-- The trigger automatically records the employee ID,
-- employee name, insertion date and database username.

