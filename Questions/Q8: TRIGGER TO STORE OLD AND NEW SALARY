/*
Q8: TRIGGER TO STORE OLD AND NEW SALARY

Aim:
To create a trigger that stores the old and new salary
whenever an employee's salary is updated.
*/

-- STEP 1: CREATE AUDIT TABLE
-- Run only if SALARY_AUDIT does not already exist.

CREATE TABLE SALARY_AUDIT (
    EID NUMBER(5),
    OLD_SALARY NUMBER(10,2),
    NEW_SALARY NUMBER(10,2),
    CHANGE_DATE DATE
);

-- STEP 2: CREATE TRIGGER

CREATE OR REPLACE TRIGGER TRG_SALARY_AUDIT
AFTER UPDATE OF BASICSAL ON EMP
FOR EACH ROW
BEGIN
    INSERT INTO SALARY_AUDIT (
        EID,
        OLD_SALARY,
        NEW_SALARY,
        CHANGE_DATE
    )
    VALUES (
        :OLD.EID,
        :OLD.BASICSAL,
        :NEW.BASICSAL,
        SYSDATE
    );
END;
/

-- STEP 3: CHECK TRIGGER ERRORS

SHOW ERRORS;

-- STEP 4: CHECK CURRENT SALARY

SELECT EID, ENAME, BASICSAL
FROM EMP
WHERE EID = 101;

-- STEP 5: UPDATE SALARY

UPDATE EMP
SET BASICSAL = 35000
WHERE EID = 101;

COMMIT;

-- STEP 6: DISPLAY AUDIT RECORDS

SELECT * FROM SALARY_AUDIT;

-- Expected:
-- EID: 101
-- OLD_SALARY: 20000 (if this was the previous salary)
-- NEW_SALARY: 35000
-- CHANGE_DATE: Current database date and time

-- STEP 7: RESULT
-- The trigger stores the employee ID, old salary,
-- new salary and change date whenever salary is updated.

