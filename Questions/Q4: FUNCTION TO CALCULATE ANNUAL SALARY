/*
Q4: FUNCTION TO CALCULATE ANNUAL SALARY

Aim:
To create a function that accepts monthly salary
and returns annual salary.

Formula:
Annual Salary = Monthly Salary * 12
*/

-- STEP 1: CREATE FUNCTION

CREATE OR REPLACE FUNCTION ANNUAL_SALARY(
    P_MONTHLY_SALARY NUMBER
)
RETURN NUMBER
IS
BEGIN
    RETURN P_MONTHLY_SALARY * 12;
END;
/

-- STEP 2: CHECK COMPILATION

SHOW ERRORS;

-- STEP 3: EXECUTE FUNCTION

SELECT ANNUAL_SALARY(20000) AS ANNUAL_SALARY
FROM DUAL;

-- Expected Output: 240000

-- STEP 4: TEST WITH ANOTHER VALUE

SELECT ANNUAL_SALARY(15000) AS ANNUAL_SALARY
FROM DUAL;

-- Expected Output: 180000

-- STEP 5: RESULT
-- The function successfully calculates and returns
-- annual salary from the given monthly salary.

