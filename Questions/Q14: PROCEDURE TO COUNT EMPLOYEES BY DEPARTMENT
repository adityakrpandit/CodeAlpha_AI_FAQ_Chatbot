/*
Q14: PROCEDURE TO COUNT EMPLOYEES BY DEPARTMENT

Aim:
To create a procedure that accepts a department number
and returns the number of employees through an OUT parameter.
*/

-- STEP 1: CREATE PROCEDURE

CREATE OR REPLACE PROCEDURE COUNT_EMP(
    P_DEPTNO IN NUMBER,
    P_TOTAL OUT NUMBER
)
IS
BEGIN
    SELECT COUNT(*)
    INTO P_TOTAL
    FROM EMP
    WHERE DEPTNO = P_DEPTNO;
END;
/

-- STEP 2: CHECK COMPILATION

SHOW ERRORS;

-- STEP 3: EXECUTE PROCEDURE

SET SERVEROUTPUT ON;

DECLARE
    V_TOTAL NUMBER;
BEGIN
    COUNT_EMP(10, V_TOTAL);

    DBMS_OUTPUT.PUT_LINE(
        'Total Employees: ' || V_TOTAL
    );
END;
/

-- Expected Output:
-- Total Employees: 2
-- (If two employees belong to Department 10.)

-- STEP 4: ACCEPT DEPARTMENT NUMBER AS INPUT

DECLARE
    V_DEPTNO NUMBER := &DEPTNO;
    V_TOTAL NUMBER;
BEGIN
    COUNT_EMP(V_DEPTNO, V_TOTAL);

    DBMS_OUTPUT.PUT_LINE(
        'Department Number: ' || V_DEPTNO
    );

    DBMS_OUTPUT.PUT_LINE(
        'Total Employees: ' || V_TOTAL
    );
END;
/

-- Example Input: 20
-- The output depends on the employees in Department 20.

-- STEP 5: RESULT
-- The procedure successfully counts employees
-- belonging to the specified department and returns
-- the count through an OUT parameter.

