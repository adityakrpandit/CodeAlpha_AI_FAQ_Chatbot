/*
Q9: TRIGGER TO STORE DELETED EMPLOYEE INFORMATION

Aim:
To create a trigger that stores deleted employee
information in an audit table.
*/

-- STEP 1: CREATE AUDIT TABLE
-- Run only if EMP_DELETE_AUDIT does not already exist.

CREATE TABLE EMP_DELETE_AUDIT (
    EID NUMBER(5),
    ENAME VARCHAR2(30),
    DEPTNO NUMBER,
    DEPTNAME VARCHAR2(30),
    GENDER VARCHAR2(10),
    AGE NUMBER,
    BASICSAL NUMBER(10,2),
    DELETE_DATE DATE
);

-- STEP 2: CREATE TRIGGER

CREATE OR REPLACE TRIGGER TRG_EMP_DELETE
BEFORE DELETE ON EMP
FOR EACH ROW
BEGIN
    INSERT INTO EMP_DELETE_AUDIT (
        EID,
        ENAME,
        DEPTNO,
        DEPTNAME,
        GENDER,
        AGE,
        BASICSAL,
        DELETE_DATE
    )
    VALUES (
        :OLD.EID,
        :OLD.ENAME,
        :OLD.DEPTNO,
        :OLD.DEPTNAME,
        :OLD.GENDER,
        :OLD.AGE,
        :OLD.BASICSAL,
        SYSDATE
    );
END;
/

-- STEP 3: CHECK TRIGGER ERRORS

SHOW ERRORS;

-- STEP 4: CHECK EMPLOYEE BEFORE DELETION

SELECT * FROM EMP
WHERE EID = 104;

-- STEP 5: DELETE EMPLOYEE
-- Use an existing EID that you intend to delete.

DELETE FROM EMP
WHERE EID = 104;

COMMIT;

-- STEP 6: DISPLAY DELETED EMPLOYEE INFORMATION

SELECT * FROM EMP_DELETE_AUDIT;

-- Expected:
-- Deleted employee details and deletion date
-- should appear in EMP_DELETE_AUDIT.

-- STEP 7: RESULT
-- The trigger successfully stores employee information
-- before the employee record is deleted.

