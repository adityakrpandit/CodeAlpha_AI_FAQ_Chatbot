/*
Q10: SALARY HISTORY TABLE AND TRIGGER

Aim:
To create a SALARY_HISTORY table and a trigger
to store employee ID, old salary, new salary,
and change date whenever salary is updated.
*/

-- STEP 1: CREATE SALARY_HISTORY TABLE
-- Run only if SALARY_HISTORY does not already exist.

CREATE TABLE SALARY_HISTORY (
    EMP_ID NUMBER(5),
    OLD_SAL NUMBER(10,2),
    NEW_SAL NUMBER(10,2),
    CHANGE_DATE DATE
);

-- STEP 2: CREATE TRIGGER

CREATE OR REPLACE TRIGGER TRG_SALARY_HISTORY
AFTER UPDATE OF BASICSAL ON EMP
FOR EACH ROW
BEGIN
    INSERT INTO SALARY_HISTORY (
        EMP_ID,
        OLD_SAL,
        NEW_SAL,
        CHANGE_DATE
    )
    VALUES (
        :OLD.EID,
        :OLD.BASICSAL,
        :NEW.BASICSAL,
        SYSDATE
    );
END;
/

-- STEP 3: CHECK TRIGGER ERRORS

SHOW ERRORS;

-- STEP 4: CHECK CURRENT EMPLOYEE SALARY

SELECT EID, ENAME, BASICSAL
FROM EMP
WHERE EID = 101;

-- STEP 5: UPDATE SALARY

UPDATE EMP
SET BASICSAL = 36000
WHERE EID = 101;

COMMIT;

-- STEP 6: DISPLAY SALARY HISTORY

SELECT * FROM SALARY_HISTORY;

-- Expected:
-- EMP_ID: 101
-- OLD_SAL: Previous salary of employee 101
-- NEW_SAL: 36000
-- CHANGE_DATE: Current database date and time

-- STEP 7: RESULT
-- The trigger successfully records salary changes
-- in the SALARY_HISTORY table.

