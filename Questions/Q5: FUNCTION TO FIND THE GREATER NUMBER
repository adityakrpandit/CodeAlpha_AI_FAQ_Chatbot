/*
Q5: FUNCTION TO FIND THE GREATER NUMBER

Aim:
To create a function that accepts two numbers
and returns the greater number.
*/

-- STEP 1: CREATE FUNCTION

CREATE OR REPLACE FUNCTION GREATER_NUM(
    P_NUM1 NUMBER,
    P_NUM2 NUMBER
)
RETURN NUMBER
IS
BEGIN
    IF P_NUM1 > P_NUM2 THEN
        RETURN P_NUM1;
    ELSE
        RETURN P_NUM2;
    END IF;
END;
/

-- STEP 2: CHECK COMPILATION

SHOW ERRORS;

-- STEP 3: TEST CASE 1

SELECT GREATER_NUM(25, 40) AS GREATER_NUMBER
FROM DUAL;

-- Expected Output: 40

-- STEP 4: TEST CASE 2

SELECT GREATER_NUM(80, 30) AS GREATER_NUMBER
FROM DUAL;

-- Expected Output: 80

-- STEP 5: TEST CASE 3

SELECT GREATER_NUM(15, 15) AS GREATER_NUMBER
FROM DUAL;

-- Expected Output: 15

-- STEP 6: RESULT
-- The function successfully returns the greater
-- of two given numbers.

